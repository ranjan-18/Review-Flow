{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/owner/(.*)",
      "destination": "/owner/index.html"
    },
    {
      "source": "/(?!api/)(.*)",
      "destination": "/index.html"
    }
  ]
}
