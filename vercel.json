{
  "version": 2,
  "builds": [
    {
      "src": "client-admin/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://review-flow-sovb.onrender.com/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/client-admin/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/client-admin/dist/index.html"
    }
  ]
}
