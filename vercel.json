{
  "version": 2,
  "builds": [
    {
      "src": "client-admin/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/client-admin/dist/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/client-admin/dist/index.html"
    }
  ]
}
